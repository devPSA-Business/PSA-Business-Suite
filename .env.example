# ══════════════════════════════════════════════════════════════════════════════
# PSA Business Suite — Template Konfigurasi Environment
# ══════════════════════════════════════════════════════════════════════════════
#
# CARA PAKAI (pengembangan lokal):
#   1. Salin file ini: cp .env.example .env.local
#   2. Isi nilai di .env.local (JANGAN commit .env.local ke Git!)
#   3. Jalankan: npm run dev
#
# UNTUK PRODUCTION (GitHub Actions):
#   → Isi semua nilai di: GitHub repo → Settings → Secrets and variables → Actions
#   → Panduan lengkap: lihat file DEPLOY_SOP.md
#
# ══════════════════════════════════════════════════════════════════════════════

# ── FIREBASE — WAJIB (7 nilai dari Firebase Console) ────────────────────────
# Lokasi: Firebase Console → Project Settings → General → Your apps → (pilih web app)
# Salin dari bagian "firebaseConfig" di halaman tersebut.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── KRIPTOGRAFI — WAJIB ──────────────────────────────────────────────────────
# Pepper PBKDF2 untuk PIN kasir. Minimal 32 karakter acak.
# ⚠️  JANGAN UBAH setelah production digunakan — semua PIN kasir akan invalid.
# Di GitHub Actions: diisi otomatis oleh workflow "Bootstrap Secrets".
# Untuk dev lokal, gunakan string acak apa saja (contoh: 32 karakter hex acak).

VITE_CRYPTO_PEPPER=

# ── AI / SMART INSIGHTS — OPSIONAL ──────────────────────────────────────────
# URL Cloudflare Worker proxy untuk fitur AI (Natural Language Query).
# Kosong = fitur AI dinonaktifkan. Seluruh fitur kasir tetap berjalan normal.

VITE_GEMINI_PROXY_URL=

# ── MONITORING TELEGRAM — OPSIONAL ──────────────────────────────────────────
# Alert otomatis ke Telegram saat ada error kritis di sistem.
# Kosong = monitoring Telegram dinonaktifkan.

VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# ── ERROR TRACKING — OPSIONAL ────────────────────────────────────────────────
# Sentry DSN untuk pelacakan error di production.
# Kosong = error tracking dinonaktifkan.

VITE_SENTRY_DSN=

# ── APP CHECK / RECAPTCHA — OPSIONAL ─────────────────────────────────────────
# Firebase App Check via reCAPTCHA v3 Enterprise.
# Kosong = App Check dinonaktifkan (aman untuk Spark Plan).

VITE_RECAPTCHA_SITE_KEY=

# ── NOTIFIKASI EMAIL DEPLOY — OPSIONAL ───────────────────────────────────────
# Akun Gmail untuk kirim email notifikasi saat deploy berhasil/gagal.
# Gunakan App Password Gmail (bukan password akun biasa).
# Kosong = notifikasi email dinonaktifkan.

MAIL_USERNAME=
MAIL_PASSWORD=
