{
  "name": "psa-business-suite",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "scripts": {
    "start": "vite preview",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:staging": "vite build --mode staging",
    "deploy:staging": "npm run build:staging && firebase deploy --only hosting:staging",
    "deploy:prod": "npm run build && firebase deploy --only hosting:production",
    "deploy:preview": "npm run build:staging && firebase hosting:channel:deploy preview-$(date +%Y%m%d)",
    "clean": "rm -rf dist",
    "lint": "eslint src && tsc --noEmit",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run tests/stress",
    "test:backup": "tsx scripts/validate_backup.ts",
    "test:ai-context": "tsx scripts/verify-ai-context.ts",
    "audit:deps": "npm ls --production --depth=0"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-virtual": "^3.14.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.3",
    "dexie-export-import": "^4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^11.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.14",
    "@sentry/react": "^10.57.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-usb": "^1.0.14",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-remove-console": "^2.2.0",
    "vitest": "^4.1.8",
    "@sentry/vite-plugin": "^5.3.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.0.5",
    "@tootallnate/once": "^3.0.1"
  }
}
